{
    "name": "k2labs/base-tenant",
    "description": "Multi-tenant SaaS foundation for Laravel 13: account isolation that survives queued jobs, per-account permissions, enforced plan limits and fifteen capability modules.",
    "type": "library",
    "homepage": "https://k2labs.tech/products",
    "keywords": [
        "laravel",
        "multi-tenant",
        "multitenancy",
        "saas",
        "tenancy",
        "rbac",
        "permissions",
        "livewire",
        "flux",
        "cashier",
        "stripe",
        "passkeys",
        "webauthn",
        "gdpr"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Dani",
            "email": "dani@ideasandbusiness.com"
        },
        {
            "name": "Nico",
            "email": "nico@ideasandbusiness.com"
        },
        {
            "name": "Enric",
            "email": "enric@ideasandbusiness.com"
        }
    ],
    "support": {
        "issues": "https://github.com/k2labs-tech/base-tenant/issues",
        "source": "https://github.com/k2labs-tech/base-tenant",
        "docs": "https://github.com/k2labs-tech/base-tenant/tree/main/docs"
    },
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/support": "^12.0",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/cashier": "^16.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/vapor-core": "^2.37",
        "livewire/flux": "^2.4",
        "livewire/flux-pro": "^2.4",
        "livewire/livewire": "^4.0",
        "livewire/volt": "^1.10",
        "pragmarx/google2fa-laravel": "^2.3",
        "spatie/laravel-flare": "^2.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Base\\Tenant\\": "src/",
            "Base\\Tenant\\Database\\Factories\\": "database/factories/",
            "Base\\Tenant\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Base\\Tenant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Base\\Tenant\\BaseTenantServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "livewire/flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    },
    "suggest": {
        "livewire/flux-pro": "Adds the Flux Pro component library. The package itself uses only free Flux components, so this is purely for your own screens.",
        "league/flysystem-aws-s3-v3": "Required by the files module when storing on S3 or Vapor (BASE_TENANT_FILES_DRIVER=vapor).",
        "ext-gd": "Required to derive image variants (thumbnails and previews) for uploaded files."
    }
}
