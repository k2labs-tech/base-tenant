{
    "name": "base/tenant",
    "description": "Multi-tenant SaaS base package with subscriptions, RBAC, and team collaboration for Laravel 13",
    "type": "library",
    "keywords": [
        "laravel",
        "multi-tenant",
        "saas",
        "subscriptions",
        "rbac",
        "livewire",
        "cashier"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Your Name",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/cashier": "^16.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^2.9|^3.0",
        "livewire/flux": "^2.4",
        "livewire/livewire": "^4.0",
        "pragmarx/google2fa-laravel": "^2.3|^3.0",
        "socialiteproviders/microsoft": "^4.10",
        "spatie/laravel-flare": "^2.2|^3.0",
        "spatie/laravel-permission": "^8.0",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Base\\Tenant\\": "src/",
            "Base\\Tenant\\Database\\Factories\\": "database/factories/",
            "Base\\Tenant\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Base\\Tenant\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Base\\Tenant\\BaseTenantServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "livewire/flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        }
    },
    "suggest": {
        "livewire/flux-pro": "Adds the Flux Pro component library. The package itself uses only free Flux components, so this is purely for your own screens.",
        "league/flysystem-aws-s3-v3": "Required by the files module when storing on S3 or Vapor (BASE_TENANT_FILES_DRIVER=vapor).",
        "ext-gd": "Required to derive image variants (thumbnails and previews) for uploaded files."
    }
}
