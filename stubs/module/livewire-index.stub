<?php

declare(strict_types=1);

namespace App\Livewire\{{ class }};

use {{ namespace }}\{{ class }};
use Base\Tenant\Livewire\Concerns\InteractsWithTable;
use Flux\Flux;
use Illuminate\Contracts\View\View;
use Illuminate\Database\Eloquent\Builder;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Facades\Auth;
use Livewire\Attributes\Layout;
use Livewire\Component;
use Livewire\WithPagination;

/**
 * Generated by k2labs-base:make-module. Follows the package's table pattern:
 * search, sort, page size and density all travel in the URL, and sorting is
 * whitelisted because `sortBy` arrives from the query string.
 */
#[Layout('base-tenant::layouts.app')]
class Index extends Component
{
    use InteractsWithTable;
    use WithPagination;

    public bool $showDeleteModal = false;

    public string $deletingId = '';

    public function mount(): void
    {
        $this->authorize('viewAny', {{ class }}::class);
    }

    public function render(): View
    {
        ${{ plural }} = $this->records();

        return view('livewire.{{ kebab }}.index', [
            '{{ plural }}' => ${{ plural }},
            'isEmptyTable' => $this->isEmptyResult(${{ plural }}),
            'hasActiveFilters' => $this->hasActiveFilters(),
            'total' => {{ class }}::query()->count(),
            'canCreate' => Auth::user()->can('create', {{ class }}::class),
            'perPageOptions' => self::PER_PAGE_OPTIONS,
            'density' => $this->resolvedDensity(),
            'rowPadding' => $this->densityClasses(),
        ]);
    }

    /** @return array<int, string> */
    protected function sortableColumns(): array
    {
        return [{{ sortable }}];
    }

    public function hasActiveFilters(): bool
    {
        return $this->search !== '';
    }

    public function confirmDelete(string $id): void
    {
        $this->deletingId = $id;
        $this->showDeleteModal = true;
    }

    public function deleting(): ?{{ class }}
    {
        return $this->deletingId === '' ? null : {{ class }}::query()->find($this->deletingId);
    }

    public function delete(): void
    {
        ${{ variable }} = $this->deleting();

        if (! ${{ variable }}) {
            return;
        }

        $this->authorize('delete', ${{ variable }});

        ${{ variable }}->delete();

        $this->reset(['deletingId', 'showDeleteModal']);

        Flux::toast(text: __('{{ kebab }}.deleted'), variant: 'success');
    }

    /**
     * @return LengthAwarePaginator<int, {{ class }}>
     */
    protected function records(): LengthAwarePaginator
    {
        $query = {{ class }}::query()
            ->when($this->search !== '', fn (Builder $query) => $query->where(
                '{{ searchColumn }}',
                'like',
                '%'.trim($this->search).'%'
            ));

        return $this->applySort($query, 'created_at', 'desc')
            ->paginate($this->resolvedPerPage());
    }
}
