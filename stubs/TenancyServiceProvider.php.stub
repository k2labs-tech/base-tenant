<?php

declare(strict_types=1);

namespace {{ namespace }}\Providers;

use {{ namespace }}\Menu\DefaultMenus;
use {{ namespace }}\Menu\MenuManager;
use {{ namespace }}\Tenancy\QueueTenancy;
use {{ namespace }}\Tenancy\TenantTeamResolver;
use Illuminate\Auth\Notifications\ResetPassword;
use Illuminate\Contracts\Events\Dispatcher;
use Illuminate\Routing\Router;
use Illuminate\Support\Facades\Blade;
use Illuminate\Support\Facades\Gate;
use Illuminate\Support\ServiceProvider;
use Livewire\Livewire;

/**
 * Wires up the tenancy, permission and navigation code that now lives in this
 * application.
 *
 * Generated by `base-tenant:scaffold`. It is yours: edit it freely.
 */
class TenancyServiceProvider extends ServiceProvider
{
    public function register(): void
    {
        $this->configurePermissionPackage();

        foreach ([
{{ singletons }}
        ] as $singleton) {
            $this->app->singleton($singleton);
        }
    }

    public function boot(): void
    {
        $this->loadViewsFrom(resource_path('views/{{ handle }}'), '{{ handle }}');
        $this->loadTranslationsFrom(lang_path('{{ handle }}'), '{{ handle }}');

        $this->loadRoutesFrom(base_path('routes/{{ handle }}/web.php'));
        $this->loadRoutesFrom(base_path('routes/{{ handle }}/auth.php'));
        $this->loadRoutesFrom(base_path('routes/{{ handle }}/subscriptions.php'));

        $this->bootTenancy();
        $this->registerAuthorization();
        $this->registerMenus();
        $this->registerMiddleware();
        $this->registerLivewireComponents();
        $this->registerBladeComponents();
        $this->registerCommands();
        $this->configurePasswordReset();
    }

    /**
     * Point spatie/laravel-permission at this application's models and make
     * `account_id` its team column, so every role assignment is scoped to a
     * tenant.
     */
    protected function configurePermissionPackage(): void
    {
        config([
            'permission.teams' => true,
            'permission.team_resolver' => TenantTeamResolver::class,
            'permission.column_names.team_foreign_key' => 'account_id',
            'permission.column_names.model_morph_key' => 'model_id',
            'permission.models.role' => config('base-tenant.models.role'),
            'permission.models.permission' => config('base-tenant.models.permission'),
        ]);
    }

    /**
     * Carry the tenant across the queue boundary. The permission layer reads
     * the tenant through TenantTeamResolver, so it needs no wiring here.
     */
    protected function bootTenancy(): void
    {
        if (config('base-tenant.tenancy.propagate_to_queue', true)) {
            QueueTenancy::register($this->app->make(Dispatcher::class));
        }
    }

    protected function registerAuthorization(): void
    {
        foreach ([
{{ policies }}
        ] as $key => $policy) {
            Gate::policy(config("base-tenant.models.{$key}"), $policy);
        }

        Gate::before(function ($user): ?bool {
            if (method_exists($user, 'isSuperAdmin') && $user->isSuperAdmin()) {
                return true;
            }

            return null;
        });
    }

    protected function registerMenus(): void
    {
        if (! config('base-tenant.menu.enabled', true)) {
            return;
        }

        DefaultMenus::register();

        $this->app->make(MenuManager::class)->bootBadgeResolvers();
    }

    protected function registerMiddleware(): void
    {
        $router = $this->app->make(Router::class);

        foreach ([
{{ middleware }}
        ] as $alias => $middleware) {
            $router->aliasMiddleware($alias, $middleware);
        }

        $router->pushMiddlewareToGroup('web', \{{ namespace }}\Http\Middleware\SetAccountContext::class);

        if (config('base-tenant.force_password_change.enabled', false)) {
            $router->pushMiddlewareToGroup('web', \{{ namespace }}\Http\Middleware\EnsurePasswordChanged::class);
        }
    }

    protected function registerLivewireComponents(): void
    {
        foreach ([
{{ livewire }}
        ] as $name => $class) {
            Livewire::component($name, $class);
        }
    }

    protected function registerBladeComponents(): void
    {
        foreach ([
{{ blade }}
        ] as $alias => $class) {
            Blade::component($alias, $class);
        }

        Blade::if('feature', fn (string $feature): bool => \{{ namespace }}\Facades\Feature::active($feature));
    }

    protected function registerCommands(): void
    {
        if (! $this->app->runningInConsole()) {
            return;
        }

        $this->commands([
{{ commands }}
        ]);
    }

    protected function configurePasswordReset(): void
    {
        ResetPassword::createUrlUsing(function ($notifiable, string $token): string {
            return url(route('base-tenant.password.reset', [
                'token' => $token,
                'email' => $notifiable->getEmailForPasswordReset(),
            ], false));
        });
    }
}
